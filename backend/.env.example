# Local development default (may be omitted because config uses this value).
DATABASE_URL=sqlite+aiosqlite:///./arroh_dev.db
# Production example: postgresql+asyncpg://arroh:arroh@localhost:5432/arroh
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
API_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
